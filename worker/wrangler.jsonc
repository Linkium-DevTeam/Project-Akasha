{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-akasha",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "vars": {
    "CHAIN_DIFFICULTY": "2",
    "AUTH_TOKEN": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akasha",
      "database_id": "2fd1809c-da0a-4332-bf79-bf95786283db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "akasha-images"
    }
  ]
}
