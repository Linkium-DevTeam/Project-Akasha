{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-akasha",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  // 关闭 workers.dev 入口：Access 应用只保护自定义域名，
  // 保留 workers.dev 会形成绕过写入验证的旁路
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
    "redact_query_string": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  // 自定义域名：deploy 时自动创建 DNS 记录（proxied）并签发边缘证书
  "routes": [
    { "pattern": "akasha.linkium.top", "custom_domain": true }
  ],
  "vars": {
    "CHAIN_DIFFICULTY": "2",
    // Worker 端 Access JWT 校验（纵深防御）：从 Access 登录 URL / 控制台获取
    "ACCESS_TEAM_DOMAIN": "linkiumdevteam.cloudflareaccess.com",
    "ACCESS_AUD": "a51d1a1eb9b6c55b46349a972c5a1446e2dbc7865e1d19e0ec6d17479507f507"
  },
  // Workers AI：图片识别 / 联网补全建议
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akasha",
      "database_id": "2fd1809c-da0a-4332-bf79-bf95786283db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "akasha-images"
    }
  ]
}
